# -----------------------------------------------------------------------------
# Plantilla de claves del asistente virtual.
#
# Copiá este archivo como `claves.env` y completá los valores. El archivo
# claves.env está ignorado por git, así que tus claves no se suben nunca.
#
#   cp claves.env.example claves.env
#
# Formato: CLAVE=valor, una por línea. Las líneas con # son comentarios.
# Si la variable ya existe en el entorno, tiene prioridad sobre el archivo.
# -----------------------------------------------------------------------------

# Principal — https://console.groq.com/keys
GROQ_API_KEY=

# Respaldo — https://aistudio.google.com/apikey
GEMINI_API_KEY=
